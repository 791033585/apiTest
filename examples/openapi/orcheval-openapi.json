{
  "openapi": "3.1.0",
  "info": {
    "title": "OrchEval 智能客服",
    "description": "Multi-Agent customer-service orchestration with intent routing, RAG, conversation memory, monitoring, and automated evaluation.",
    "version": "2.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Check service health",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Orchestration service is not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/skills": {
      "get": {
        "tags": [
          "Skills"
        ],
        "summary": "List loaded Agent Skills",
        "description": "查看当前已加载的 Skills，便于确认热加载结果和排查解析错误。",
        "operationId": "listSkills",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkillsResponse"
                }
              }
            }
          },
          "503": {
            "description": "Skill manager is not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/skills/reload": {
      "post": {
        "tags": [
          "Skills"
        ],
        "summary": "Reload Agent Skills",
        "description": "运行时重新扫描 Skill 目录，不需要重启服务。",
        "operationId": "reloadSkills",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkillsResponse"
                }
              }
            }
          },
          "503": {
            "description": "Skill manager is not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/chat": {
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Run the Multi-Agent chat workflow",
        "description": "主对话接口。完整流程：\n  记忆读取 → 意图识别 → Agent 路由 → 执行 → 记忆写入",
        "operationId": "chat",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "503": {
            "description": "Chat service is not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/monitor": {
      "get": {
        "tags": [
          "Monitoring"
        ],
        "summary": "Get Agent and tool monitoring summary",
        "description": "实时监控摘要：Agent 成功率、工具统计、告警、优化建议。",
        "operationId": "getMonitorSummary",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Monitoring service is not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/eval/dashboard/runs": {
      "get": {
        "tags": [
          "Evaluation"
        ],
        "summary": "List saved evaluation runs",
        "description": "列出磁盘中已有的评测结果；不会启动新评测。",
        "operationId": "listEvaluationRuns",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DashboardRunSummary"
                  },
                  "type": "array",
                  "title": "Response Listevaluationruns"
                }
              }
            }
          }
        }
      }
    },
    "/eval/dashboard/runs/{run_id}": {
      "get": {
        "tags": [
          "Evaluation"
        ],
        "summary": "Get an evaluation dashboard",
        "description": "聚合一个已保存 EvalRun，且不返回 Prompt 或密钥。",
        "operationId": "getEvaluationRun",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardResponse"
                }
              }
            }
          },
          "400": {
            "description": "The run identifier is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The evaluation run does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "Monitoring"
        ],
        "summary": "Export Prometheus metrics",
        "description": "Prometheus 指标入口。",
        "operationId": "prometheusMetrics",
        "responses": {
          "200": {
            "description": "Prometheus text exposition format.",
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "post": {
        "tags": [
          "Knowledge Base"
        ],
        "summary": "Search knowledge with query rewriting and reranking",
        "description": "演示检索优化链路：查询改写 → 并行召回 → 重排 → Top-K。\n展示 MCP 工具调用的核心亮点。",
        "operationId": "searchKnowledge",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Natural-language knowledge query.",
              "examples": [
                "退款需要多久到账"
              ],
              "title": "Query"
            },
            "description": "Natural-language knowledge query."
          },
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "description": "Maximum number of reranked results.",
              "default": 5,
              "title": "Top K"
            },
            "description": "Maximum number of reranked results."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "503": {
            "description": "Knowledge tools are not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/knowledge/add": {
      "post": {
        "tags": [
          "Knowledge Base"
        ],
        "summary": "Add documents to the knowledge base",
        "description": "批量导入文档到知识库。\n\n文档会自动切片（每片 500 字）并存入 ChromaDB，ChromaDB 内置 Embedding 模型自动向量化。\n\n示例请求体：\n```json\n{\n  \"documents\": [\n    {\"title\": \"退款政策\", \"content\": \"用户在购买后 7 天内可以申请无理由退款...\"},\n    {\"title\": \"配送说明\", \"content\": \"标准配送 3-5 个工作日...\"}\n  ]\n}\n```",
        "operationId": "addKnowledge",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchDocInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeImportResponse"
                }
              }
            }
          },
          "503": {
            "description": "Knowledge base is not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/knowledge/upload": {
      "post": {
        "tags": [
          "Knowledge Base"
        ],
        "summary": "Upload a knowledge document",
        "description": "上传文件导入知识库。\n\n支持格式：\n- `.txt` / `.md`：整个文件作为一篇文档，文件名作为标题\n- `.json`：JSON 数组格式 `[{\"title\": \"...\", \"content\": \"...\"}, ...]`\n\n文件大小限制：10MB",
        "operationId": "uploadKnowledge",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_uploadKnowledge"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeImportResponse"
                }
              }
            }
          },
          "400": {
            "description": "The uploaded JSON file is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "The uploaded file exceeds 10 MB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Knowledge base is not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/knowledge/stats": {
      "get": {
        "tags": [
          "Knowledge Base"
        ],
        "summary": "Get knowledge-base statistics",
        "description": "查看知识库统计信息（文档片段总数）。",
        "operationId": "getKnowledgeStats",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowledgeStatsResponse"
                }
              }
            }
          },
          "503": {
            "description": "Knowledge base is not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/eval/run": {
      "post": {
        "tags": [
          "Evaluation"
        ],
        "summary": "Run a formal or compatibility evaluation",
        "description": "运行正式版本化评测；传旧字段时走兼容评测器。",
        "operationId": "runEvaluation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/EvalRunInput"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/FormalEvaluationResponse"
                    },
                    {
                      "$ref": "#/components/schemas/LegacyEvaluationResponse"
                    }
                  ],
                  "title": "Response Runevaluation"
                }
              }
            }
          },
          "400": {
            "description": "The dataset or evaluation request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Evaluation services are not ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentStats": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total",
            "default": 0
          },
          "success_rate": {
            "type": "number",
            "title": "Success Rate",
            "default": 1.0
          },
          "avg_ms": {
            "type": "number",
            "title": "Avg Ms",
            "default": 0.0
          },
          "monitor_penalty": {
            "type": "number",
            "title": "Monitor Penalty",
            "default": 0.0
          },
          "routing_score": {
            "type": "number",
            "title": "Routing Score",
            "default": 1.0
          }
        },
        "type": "object",
        "title": "AgentStats"
      },
      "BatchDocInput": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocInput"
            },
            "type": "array",
            "minItems": 1,
            "title": "Documents"
          }
        },
        "type": "object",
        "required": [
          "documents"
        ],
        "title": "BatchDocInput",
        "description": "Batch document import request.",
        "examples": [
          {
            "documents": [
              {
                "content": "用户在订单取消后 5 至 7 个工作日内收到退款。",
                "title": "退款政策"
              }
            ]
          }
        ]
      },
      "Body_uploadKnowledge": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File",
            "description": "UTF-8 text, Markdown, or a JSON array of {title, content} objects. Maximum size: 10 MB."
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_uploadKnowledge"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "title": "Message",
            "description": "User message sent to the orchestration pipeline.",
            "examples": [
              "我的订单已经取消，退款多久到账？"
            ]
          },
          "user_id": {
            "type": "string",
            "minLength": 1,
            "title": "User Id",
            "description": "Stable user identifier used for conversation memory isolation.",
            "default": "anonymous",
            "examples": [
              "user-1001"
            ]
          },
          "conv_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Conv Id",
            "description": "Existing conversation identifier. Omit it to start a new conversation.",
            "examples": [
              "conv-20260911-001"
            ]
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest",
        "examples": [
          {
            "message": "我的订单已经取消，退款多久到账？",
            "user_id": "user-1001"
          }
        ]
      },
      "ChatResponse": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "conv_id": {
            "type": "string",
            "title": "Conv Id"
          },
          "response": {
            "type": "string",
            "title": "Response"
          },
          "intent": {
            "type": "string",
            "title": "Intent"
          },
          "intent_group": {
            "type": "string",
            "title": "Intent Group",
            "default": "other"
          },
          "agent_type": {
            "type": "string",
            "title": "Agent Type"
          },
          "agent_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Agent Types"
          },
          "primary_agent": {
            "type": "string",
            "title": "Primary Agent",
            "default": ""
          },
          "supporting_agents": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Supporting Agents"
          },
          "routing_reason": {
            "type": "string",
            "title": "Routing Reason",
            "default": ""
          },
          "routing_confidence": {
            "type": "number",
            "title": "Routing Confidence",
            "default": 0.0
          },
          "escalated": {
            "type": "boolean",
            "title": "Escalated"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          },
          "knowledge_used": {
            "type": "boolean",
            "title": "Knowledge Used",
            "default": false
          },
          "entities": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Entities"
          },
          "intent_confidence": {
            "type": "number",
            "title": "Intent Confidence",
            "default": 0.0
          },
          "intent_source_scores": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Intent Source Scores"
          },
          "trace": {
            "type": "object",
            "title": "Trace"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "conv_id",
          "response",
          "intent",
          "agent_type",
          "escalated",
          "latency_ms"
        ],
        "title": "ChatResponse"
      },
      "DashboardResponse": {
        "properties": {
          "run": {
            "$ref": "#/components/schemas/DashboardRunMetadata"
          },
          "summary": {
            "$ref": "#/components/schemas/DashboardSummary"
          },
          "intent_metrics": {
            "type": "object",
            "title": "Intent Metrics"
          },
          "judge_scores": {
            "type": "object",
            "title": "Judge Scores"
          },
          "deterministic_metrics": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Deterministic Metrics"
          },
          "stability_metrics": {
            "type": "object",
            "title": "Stability Metrics"
          },
          "latency_metrics": {
            "type": "object",
            "title": "Latency Metrics"
          },
          "dataset_composition": {
            "type": "object",
            "title": "Dataset Composition"
          },
          "failed_cases": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "title": "Failed Cases"
          }
        },
        "type": "object",
        "required": [
          "run",
          "summary",
          "intent_metrics",
          "judge_scores",
          "deterministic_metrics",
          "stability_metrics",
          "latency_metrics",
          "dataset_composition",
          "failed_cases"
        ],
        "title": "DashboardResponse"
      },
      "DashboardRunMetadata": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "dataset_name": {
            "type": "string",
            "title": "Dataset Name",
            "default": ""
          },
          "dataset_version": {
            "type": "string",
            "title": "Dataset Version",
            "default": ""
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": ""
          },
          "judge_model": {
            "type": "string",
            "title": "Judge Model",
            "default": ""
          },
          "completed_at": {
            "type": "string",
            "title": "Completed At",
            "default": ""
          },
          "trials_per_task": {
            "type": "integer",
            "title": "Trials Per Task",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "run_id"
        ],
        "title": "DashboardRunMetadata"
      },
      "DashboardRunSummary": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "dataset_name": {
            "type": "string",
            "title": "Dataset Name",
            "default": ""
          },
          "dataset_version": {
            "type": "string",
            "title": "Dataset Version",
            "default": ""
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": ""
          },
          "completed_at": {
            "type": "string",
            "title": "Completed At",
            "default": ""
          },
          "total_tasks": {
            "type": "integer",
            "title": "Total Tasks",
            "default": 0
          },
          "total_trials": {
            "type": "integer",
            "title": "Total Trials",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "run_id"
        ],
        "title": "DashboardRunSummary"
      },
      "DashboardSummary": {
        "properties": {
          "total_tasks": {
